+def _safe_probe_path(raw: str) -> str | None:
+    path = raw.strip().strip('"\'` ')
+    if not path.startswith("/api/"):
+        return None
+    # Dynamic placeholders need concrete IDs/params and are not useful as-is.
+    if any(x in path for x in ("${", "{", "}", "[", "]", "<", ">")):
+        return None
+    # Never probe mutation/auth/account endpoints, even with GET.
+    low = path.lower()
+    blocked = (
+        "login", "logout", "register", "password", "delete", "remove", "create",
+        "update", "upload", "admin", "vote", "comment", "like", "favorite",
+        "auth", "send", "report", "user/", "profile",
+    )
+    if any(x in low for x in blocked):
+        return None
+    # Trim obvious minifier punctuation accidentally captured at the end.
+    path = path.rstrip("),;:.+-")
+    return path if len(path) > 5 else None
+
+
+async def probe_discovered_apis(
+    page: Page,
+    out: Path,
+    recorder: Recorder,
+    normalizer: Normalizer,
+    limit: int = 80,
+) -> list[dict[str, Any]]:
+    """Probe statically discovered same-origin APIs using top-level GET navigation.
+
+    On this site Cloudflare has been observed to treat fetch/XHR and top-level
+    document navigation differently. We deliberately only use safe GET navigation
+    and skip endpoints whose names suggest mutations/auth/user actions.
+    """
+    await recorder.drain()
+    candidates: list[str] = []
+    seen: set[str] = set()
+    for raw in sorted(recorder.api_paths):
+        pth = _safe_probe_path(raw)
+        if not pth or pth in seen:
+            continue
+        seen.add(pth)
+        candidates.append(pth)
+
+    # A few known read-only endpoints are useful even if bundle extraction misses
+    # them because of string concatenation/minification.
+    for pth in ("/api/tags/tree",):
+        if pth not in seen:
+            candidates.append(pth)
+            seen.add(pth)
+
+    results: list[dict[str, Any]] = []
+    probe_page = await page.context.new_page()
+    probe_page.on("response", recorder.schedule_response)
+    try:
+        for pth in candidates[:limit]:
+            url = urljoin(SITE_ORIGIN, pth)
+            row: dict[str, Any] = {"path": pth, "url": url}
+            try:
+                resp = await probe_page.goto(url, wait_until="domcontentloaded", timeout=30000)
+                if resp is not None:
+                    row["status"] = resp.status
+                    row["content_type"] = (resp.headers.get("content-type") or "").lower()
+                text = (await probe_page.locator("body").inner_text())[:2_000_000]
+                row["body_prefix"] = text[:1200]
+                try:
+                    data = json.loads(text)
+                    row["json"] = True
+                    row["json_type"] = type(data).__name__
+                    if isinstance(data, list):
+                        row["json_items"] = len(data)
+                    elif isinstance(data, dict):
+                        row["json_keys"] = list(data.keys())[:40]
+                    normalizer.add_blob(data, url + "#top-level-probe")
+                except Exception:
+                    row["json"] = False
+            except Exception as e:
+                row["error"] = repr(e)
+            results.append(row)
+    finally:
+        await recorder.drain()
+        await probe_page.close()
+
+    (out / "api_probes.json").write_text(
+        json.dumps(results, ensure_ascii=False, indent=2), encoding="utf-8"
+    )
+    return results
+
