+    def _extract_api_strings(self, text: str, source: str) -> None:
+        # Front-end bundles often build URLs by concatenation, so keep both the
+        # nearest literal-looking path and a context snippet around every /api/.
+        for m in re.finditer(r"/api/", text):
+            i = m.start()
+            tail = text[i:i + 300]
+            pm = re.match(r"/api/[A-Za-z0-9_./?=&%:+~@,-]*", tail)
+            path = (pm.group(0) if pm else "/api/").rstrip('.,;')
+            if len(path) > 5:
+                self.api_paths.add(path)
+            self.api_strings.append({
+                "source": source,
+                "path_guess": path,
+                "context": text[max(0, i - 180): i + 360],
+            })
+
+    def _flatten_tag_tree(self, obj: Any) -> list[dict[str, Any]]:
+        out: list[dict[str, Any]] = []
+        def walk(x: Any, inherited_parent: int | None = None) -> None:
+            if isinstance(x, list):
+                for y in x:
+                    walk(y, inherited_parent)
+                return
+            if not isinstance(x, dict):
+                return
+            if "id" in x and "name" in x:
+                out.append({
+                    "id": x.get("id"),
+                    "name": x.get("name"),
+                    "parentIds": x.get("parentIds", []),
+                    "description": x.get("description"),
+                    "sortOrder": x.get("sortOrder"),
+                    "status": x.get("status"),
+                })
+            for y in x.get("children", []) if isinstance(x.get("children"), list) else []:
+                walk(y, x.get("id"))
+        walk(obj)
+        # same secondary tag may appear below multiple parents; dedupe by id
+        dedup: dict[str, dict[str, Any]] = {}
+        for row in out:
+            dedup[str(row.get("id"))] = row
+        return list(dedup.values())
+
